<Window x:Class="WiFiWatchdog.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Watchdog Studio" Width="1240" Height="820" MinWidth="1040" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#101C32">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="24,28,18,36">
                    <Border Background="#243C69" CornerRadius="13" Width="47" Height="47" HorizontalAlignment="Left">
                        <TextBlock Text="W" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WiFi Watchdog" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,14,0,1"/>
                    <TextBlock Text="STUDIO · PREVIEW" Foreground="#8FA8CF" FontSize="11" FontWeight="SemiBold" CharacterSpacing="1"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="22,16,16,28">
                    <Border Background="#22324C" CornerRadius="12" Padding="13">
                        <StackPanel>
                            <TextBlock Text="独立桌面控制台" Foreground="#E7EFFC" FontWeight="SemiBold"/>
                            <TextBlock Text="后台监控由便携引擎持续运行；关闭 Studio 不会停止它。" TextWrapping="Wrap"
                                       Foreground="#ABBCD6" FontSize="11" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="0.1 PREVIEW  ·  本地优先" Foreground="#6C87AC" Margin="8,16,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="工作台" Foreground="#7D96BA" FontSize="11" FontWeight="SemiBold" Margin="30,0,0,15"/>
                    <Button x:Name="NavOverview" Style="{StaticResource NavButton}" Tag="OverviewPage" Click="Navigate_Click" Content="⌂   网络概览"/>
                    <Button x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Tag="DiagnosticsPage" Click="Navigate_Click" Content="◉   智能诊断"/>
                    <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="HistoryPage" Click="Navigate_Click" Content="▤   历史事件"/>
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="SettingsPage" Click="Navigate_Click" Content="⚙   监控策略"/>
                    <Button x:Name="NavAbout" Style="{StaticResource NavButton}" Tag="AboutPage" Click="Navigate_Click" Content="ⓘ   关于软件"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E8EDF4" BorderThickness="0,0,0,1">
                <DockPanel Margin="34,0,34,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E9F4EF" CornerRadius="15" Padding="13,7" Margin="0,0,12,0">
                            <TextBlock x:Name="EngineIndicator" Text="读取引擎状态中" Foreground="#177553" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Button Click="RefreshAll_Click" Style="{StaticResource PrimaryButton}" Content="刷新总览"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageHeadline" Text="网络概览" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="PageHint" Text="掌握当前网络健康和恢复引擎状态" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="34,27,34,18">
                    <StackPanel x:Name="OverviewPage">
                        <TextBlock Text="今天，网络运行如何？" Style="{StaticResource H1}"/>
                        <TextBlock Text="实时事件来自便携版日志；Studio 只在打开时读取，不额外常驻监控。" Style="{StaticResource Meta}" Margin="0,7,0,25"/>
                        <UniformGrid Columns="3" Margin="0,0,0,6">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,18">
                                <StackPanel>
                                    <TextBlock Text="运行状况" Style="{StaticResource Meta}"/>
                                    <TextBlock x:Name="HealthValue" Text="读取中" FontSize="24" FontWeight="Bold" Margin="0,12,0,10"/>
                                    <TextBlock x:Name="HealthDetail" Text="最近一次事件" Style="{StaticResource Meta}" MaxHeight="60"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="4,0,6,18">
                                <StackPanel>
                                    <TextBlock Text="今日告警" Style="{StaticResource Meta}"/>
                                    <TextBlock x:Name="WarningsValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,10"/>
                                    <TextBlock Text="警告与错误事件" Style="{StaticResource Meta}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="10,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="今日恢复事件" Style="{StaticResource Meta}"/>
                                    <TextBlock x:Name="RepairsValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,12,0,10"/>
                                    <TextBlock Text="根据真实恢复日志统计" Style="{StaticResource Meta}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="查看事件 ›" Click="OpenHistory_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="近 14 天告警趋势" Style="{StaticResource Section}" Margin="0"/>
                                        <TextBlock Text="日志存在的日期才会产生统计；没有日志不等于网络一直正常。" Style="{StaticResource Meta}" FontSize="11" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ChartBars}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" Margin="2,0">
                                                <TextBlock Text="{Binding Count}" Foreground="#536684" HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,4"/>
                                                <Grid Height="100">
                                                    <Rectangle Width="23" Height="{Binding Height}" VerticalAlignment="Bottom" RadiusX="5" RadiusY="5" Fill="{Binding BarBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Label}" Foreground="#8090A8" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="快捷操作" Style="{StaticResource Section}"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="开始完整网络诊断" Click="RunDiagnostics_Click" Margin="0,0,12,8"/>
                                    <Button Content="启动便携恢复引擎" Click="StartEngine_Click" Margin="0,0,12,8"/>
                                    <Button Content="打开日志目录" Click="OpenLogFolder_Click" Margin="0,0,12,8"/>
                                    <Button Content="查看配置" Click="OpenSettings_Click" Margin="0,0,12,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                        <TextBlock Text="网络深度诊断" Style="{StaticResource H1}"/>
                        <TextBlock Text="四个真实 HTTP 目标 + Mihomo 控制接口 + Mixed-Port HTTPS。只读操作，不会修改系统网络。" Style="{StaticResource Meta}" Margin="0,7,0,23"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="完整诊断" Style="{StaticResource Section}"/>
                                        <TextBlock x:Name="DiagnosticTime" Text="尚未进行诊断" Style="{StaticResource Meta}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RunDiagButton" Style="{StaticResource PrimaryButton}" Content="开始检测" Click="RunDiagnostics_Click" Margin="0,0,10,0"/>
                                        <Button Content="导出脱敏报告" Click="ExportDiagnostic_Click"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="DiagnosticSummary" Text="等待诊断" TextWrapping="Wrap" FontSize="15" Foreground="#3757AD" FontWeight="SemiBold" Margin="0,22,0,10"/>
                                <TextBlock x:Name="ControllerDetail" Text="Mihomo 控制端口：未检测" Style="{StaticResource Meta}"/>
                                <TextBlock x:Name="MixedDetail" Text="Mixed-Port HTTPS：未检测" Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="端点逐项检测结果" Style="{StaticResource Section}"/>
                                <ListView x:Name="EndpointList" Height="245" Background="Transparent" BorderThickness="0">
                                    <ListView.View><GridView>
                                        <GridViewColumn Header="检测目标" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="状态" Width="110" DisplayMemberBinding="{Binding Verdict}"/>
                                        <GridViewColumn Header="HTTP" Width="70" DisplayMemberBinding="{Binding StatusText}"/>
                                        <GridViewColumn Header="耗时" Width="90" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="详情" Width="270" DisplayMemberBinding="{Binding Detail}"/>
                                    </GridView></ListView.View>
                                </ListView>
                                <TextBlock Text="完整诊断可能需要几秒。系统探测遵循 Windows 路由（包括 TUN），不强制通过 Mixed-Port。" Style="{StaticResource Meta}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="控制接口鉴权（本次会话）" Style="{StaticResource Section}"/>
                                <TextBlock Text="如需读取完整 Mihomo 模式，可在此临时输入 Controller Secret；不会保存到磁盘或诊断报告。" Style="{StaticResource Meta}" Margin="0,0,0,10"/>
                                <PasswordBox x:Name="SecretBox" Width="350" HorizontalAlignment="Left" PasswordChar="●"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
                        <TextBlock Text="事件中心" Style="{StaticResource H1}"/>
                        <TextBlock Text="检索便携恢复引擎的实际日志，支持筛选、导出及十四日告警统计。" Style="{StaticResource Meta}" Margin="0,7,0,24"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="刷新日志" Click="RefreshHistory_Click" Margin="0,0,10,0"/>
                                        <Button Content="导出 CSV" Click="ExportEvents_Click" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="LogLevelFilter" Width="130" Height="37" SelectedIndex="0" SelectionChanged="LogFilter_Changed">
                                            <ComboBoxItem Content="全部级别"/><ComboBoxItem Content="INFO"/>
                                            <ComboBoxItem Content="WARN"/><ComboBoxItem Content="ERROR"/>
                                        </ComboBox>
                                        <TextBox x:Name="LogSearch" Width="235" Height="37" Margin="10,0,0,0" TextChanged="LogFilter_Changed"
                                                 ToolTip="搜索日志内容"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="LogCount" Text="读取中…" Style="{StaticResource Meta}" Margin="0,0,0,12"/>
                                <ListView x:Name="EventList" Height="445" BorderThickness="0" Background="Transparent"
                                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListView.View><GridView>
                                        <GridViewColumn Header="时间" Width="155" DisplayMemberBinding="{Binding TimestampText}"/>
                                        <GridViewColumn Header="级别" Width="70" DisplayMemberBinding="{Binding Level}"/>
                                        <GridViewColumn Header="信息" Width="500" DisplayMemberBinding="{Binding Message}"/>
                                    </GridView></ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                        <TextBlock Text="监控与恢复策略" Style="{StaticResource H1}"/>
                        <TextBlock Text="编辑现有 Go 便携引擎的配置。修改会保存到同一份 config.json；引擎需重启后才能读取新设置。" Style="{StaticResource Meta}" Margin="0,7,0,24"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="健康检查" Style="{StaticResource Section}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="正常检测间隔 / 分钟" Style="{StaticResource Meta}"/><TextBox x:Name="CfgNormal" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="异常复检间隔 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgFailureSeconds" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="连续失败次数" Style="{StaticResource Meta}"/><TextBox x:Name="CfgFailureCount" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="自动恢复冷却 / 分钟" Style="{StaticResource Meta}"/><TextBox x:Name="CfgCooldown" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="单次连接超时 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgTimeout" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="日志保留 / 天" Style="{StaticResource Meta}"/><TextBox x:Name="CfgRetention" Margin="0,7,0,0"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Wi-Fi 恢复" Style="{StaticResource Section}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="网卡关闭等待 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgDisableWait" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="网卡恢复等待 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgStartupWait" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="Profile 重试次数" Style="{StaticResource Meta}"/><TextBox x:Name="CfgRetry" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="重试间隔 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgRetryDelay" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,14"><TextBlock Text="DHCP 等待 / 秒" Style="{StaticResource Meta}"/><TextBox x:Name="CfgDhcp" Margin="0,7,0,0"/></StackPanel>
                                </UniformGrid>
                                <CheckBox x:Name="CfgAutoReconnect" Content="意外断开后主动重连保存的 Wi-Fi Profile" Margin="0,8,0,9"/>
                                <CheckBox x:Name="CfgWlanSvc" Content="允许重启 WlanSvc（高级兜底，有影响其他无线会话的风险）"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="VPN / Mihomo" Style="{StaticResource Section}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,15,15"><TextBlock Text="Mixed-Port / 例如 2026" Style="{StaticResource Meta}"/><TextBox x:Name="CfgMixed" Margin="0,7,0,0"/></StackPanel>
                                    <StackPanel Margin="0,0,15,15"><TextBlock Text="控制端口 / 例如 9097" Style="{StaticResource Meta}"/><TextBox x:Name="CfgController" Margin="0,7,0,0"/></StackPanel>
                                </UniformGrid>
                                <CheckBox x:Name="CfgVpnAware" Content="启用 VPN/TUN 保护，避免重置正常 Wi-Fi"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="配置方案" Style="{StaticResource Section}"/>
                                <TextBlock Text="可以保存校园网、家庭、移动热点等不同方案；切换方案不会自动断开网络。" Style="{StaticResource Meta}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBox x:Name="PresetName" Width="190" Height="39" Margin="0,0,10,0" ToolTip="输入方案名称"/>
                                    <Button Content="保存为方案" Click="SavePreset_Click" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="PresetList" Width="165" Height="39" Margin="0,0,10,0"/>
                                    <Button Content="载入方案" Click="LoadPreset_Click" Margin="0,0,10,0"/>
                                    <Button Content="删除方案" Click="DeletePreset_Click"/>
                                </WrapPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="保存到引擎配置" Click="SaveSettings_Click"/>
                                    <TextBlock Text="保存后需重启便携引擎；不会立即干预网络。" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <TextBlock Text="关于 Studio" Style="{StaticResource H1}"/>
                        <TextBlock Text="多功能网络运维桌面控制台 · 与便携版并存" Style="{StaticResource Meta}" Margin="0,7,0,25"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="轻量引擎与桌面控制台分离" Style="{StaticResource Section}"/>
                                <TextBlock Text="便携版：Go / Win32，后台自动监测、恢复、托盘与最小资源占用。" Margin="0,0,0,10"/>
                                <TextBlock Text="Studio：WPF / .NET，按需打开，提供日志、诊断、图表和配置管理。" Margin="0,0,0,10"/>
                                <TextBlock Text="Studio 默认普通权限运行，不会替用户强制执行网卡禁用或更改代理。启动恢复引擎时由 Windows UAC 决定是否授权。" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="管理本机便携引擎" Style="{StaticResource Section}"/>
                                <TextBlock x:Name="EnginePathText" Text="尚未指定引擎位置" TextWrapping="Wrap" Style="{StaticResource Meta}" Margin="0,0,0,16"/>
                                <WrapPanel>
                                    <Button Content="选择引擎 EXE" Click="BrowseEngine_Click" Margin="0,0,10,10"/>
                                    <Button Content="启动引擎（UAC）" Style="{StaticResource PrimaryButton}" Click="StartEngine_Click" Margin="0,0,10,10"/>
                                    <Button Content="打开数据目录" Click="OpenDataFolder_Click" Margin="0,0,10,10"/>
                                    <Button Content="查看 GitHub" Click="OpenGithub_Click"/>
                                </WrapPanel>
                                <TextBlock Text="内置便携引擎位于 Studio 目录下 Engine/WiFiWatchdog.exe；若已有单独安装的便携版，不会覆盖它。" Style="{StaticResource Meta}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="隐私与发布说明" Style="{StaticResource Section}"/>
                                <TextBlock Text="无遥测、无远端账号、无内置广告。Controller Secret 仅存在本次输入的内存中，不保存到配置、历史或导出报告。" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="这是首个功能性 Preview 版本，尚未完成代码签名、安装器、无障碍/多 DPI 实机验收、安全渗透测试和长期稳定性认证，不应当直接当作正式商用版本部署。" Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" BorderBrush="#E8EDF4" BorderThickness="0,1,0,0">
                <DockPanel Margin="34,0">
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="#64758C" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="WiFi Watchdog Studio · 本地数据" Foreground="#96A4B8" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
